# Copia este archivo a .env y rellena los valores. NUNCA subas .env a un repositorio.
# En un VPS nuevo, `./desplegar.sh preparar …` lo genera solo con claves aleatorias.

# Dominio con el que se entra a la app (debe apuntar por DNS a la IP del servidor).
DOMINIO=hangar.midominio.com
# Correo para los avisos de Let's Encrypt (obligatorio: sin él Caddy no arranca).
CORREO_TLS=admin@midominio.com

# Genera uno con:  python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-64-caracteres-aleatorios
# Contraseña del superusuario "postgres" (sólo para copias y mantenimiento; la app no la usa).
POSTGRES_PASSWORD=cambia-esto-tambien
# Contraseña del rol "hangar" con el que conecta la app (sin privilegios, sujeto a Row-Level Security).
# Usa sólo letras y números: va dentro de la DATABASE_URL.
HANGAR_DB_PASSWORD=y-esta-otra-distinta

# Superadministrador que se crea en el PRIMER arranque (sólo si la base no tiene cuentas).
# Si dejas SUPERADMIN_PASSWORD vacío se genera una aleatoria y sale en `docker compose logs app`.
# Sea cual sea, es temporal: la app obliga a cambiarla al entrar por primera vez.
SUPERADMIN_USUARIO=superadmin
SUPERADMIN_PASSWORD=

TZ=America/Bogota
# Workers de Gunicorn (regla: 2 × núcleos + 1).
WEB_CONCURRENCY=3
# Días que se guardan las copias diarias en ./respaldos
DIAS_RESPALDO=14

# Correo saliente (opcional; también se puede configurar desde Ajustes en la app).
SMTP_SERVIDOR=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=
SMTP_NOMBRE=Hangar · Control de flota aérea agrícola
SMTP_SEGURIDAD=starttls
